# CypherVault Backend Environment Configuration
# Copy to .env or export in production container/host

# Server
PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/FileHider?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# SMTP Email Dispatch
MAIL_USERNAME=
MAIL_PASSWORD=
# Cryptography & JWT Security
VAULT_MASTER_KEY=ReplaceWithStrong32CharacterMasterKeyInProduction!
JWT_SECRET=ReplaceWithStrong256BitOrHigherSecretKeyForProductionTokenSigning!
JWT_EXPIRATION_MS=86400000
